# ── Copy this file to .env and fill in your values ────────────────────────────
# Load with:   set -a && source test_agent/.env && set +a
# Then run:    adk web test_agent

# ── Gemini / Google AI ─────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Alternative: use a GCP service account instead of an API key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Agent settings ─────────────────────────────────────────────────────────────
# Gemini model to use (default: gemini-2.0-flash)
# AGENT_MODEL=gemini-2.0-flash

# ── Tool directory ─────────────────────────────────────────────────────────────
# Path to the folder containing your tool sub-directories.
# Default: ./tools  (relative to wherever you run `adk web` from)
ADK_TOOLS_DIR=tools

# ── weather_api tool ───────────────────────────────────────────────────────────
# Open-Meteo is a public API — no key required.
# Uncomment if your OpenAPI spec uses bearer auth:
# WEATHER_API_TOKEN=your-weather-api-token

# ── docs_mcp tool ──────────────────────────────────────────────────────────────
# Bearer token for the MCP documentation server.
# MCP_DOCS_TOKEN=your-mcp-server-token

# ── score_function tool ────────────────────────────────────────────────────────
# No secrets required — this tool runs pure Python logic.

# ── GCP Secret Manager (optional) ─────────────────────────────────────────────
# Required only if any tool config uses *_secret fields (auth from Secret Manager).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Logging ────────────────────────────────────────────────────────────────────
# Python logging level for adk_tools internals (DEBUG | INFO | WARNING | ERROR)
# ADK_LOG_LEVEL=INFO
