# Copy this to .env and fill in your actual values
# Then run: set -a && source .env && set +a && adk web test_agent

# Required: Google API key for Gemini
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: Google application credentials (alternative to GOOGLE_API_KEY)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Required: Demo weather API bearer token
WEATHER_API_KEY=demo-bearer-token

# Optional: For get_customer_details tool (OpenAPI type)
GFIBER_API_KEY=your-gfiber-api-key
GFIBER_API_BASE_URL=https://api.example.com

# Optional: Environment tag for logging
AGENT_ENV=local
